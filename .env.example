# App / NextAuth
NEXTAUTH_URL=
AUTH_SECRET=
# NEXTAUTH_SECRET= # opcional; use apenas se preferir manter compatibilidade com esse nome

# Google OAuth (opcional; deixe vazio para desabilitar o provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Railway MySQL
# DB_HOST deve conter apenas o host, sem mysql://, usuario, senha, porta, database ou query string.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# Cloudinary - imagens publicas
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
